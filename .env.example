# OpenAI credentials for agent mode
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: point at a compatible base URL (Azure/OpenRouter/etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local model via llama.cpp (docker-compose.llama.yml) ---
# Start the server: docker compose -f docker-compose.llama.yml up -d
# Then swap the three vars above for these (no real key needed):
# OPENAI_API_KEY=local
# OPENAI_MODEL=Qwen/Qwen3-8B-GGUF:Q4_K_M
# OPENAI_BASE_URL=http://localhost:8080/v1

# Browser behaviour
HEADLESS=true
# Per-page navigation timeout in milliseconds
NAV_TIMEOUT_MS=30000
# Seconds to wait for stream network requests after clicking play
STREAM_WAIT_SECONDS=6

# Output
OUTPUT_CSV=output/streams.csv

# Local MySQL database (for the DB workflow: fetch stations, update new_stream_link)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=new_schema
